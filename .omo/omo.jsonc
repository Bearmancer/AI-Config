	"model_profile": "anthropic-subscription/claude-sonnet-5-5",
	"exclude_models": [
		"anthropic-subscription/claude-fable*",
		"anthropic-subscription/claude-sonnet-5",
		"anthropic-subscription/claude-haiku-4*",
		"anthropic-subscription/claude-sonnet-4*",
		"opencode-go/kimi-*",
		"*antigravity*",
		"*gemini*",
		"*qwen3.5*",
		"*qwen3.6*",
		"*qwen3.8-max*",
		"*grok*",
		"*claude-opus*",
	],
	// Research / web-search / knowledge skill packs hidden from discovery (owner request, 2026-11-02); annotate-paper added after the later "all research/academia" request; data-scientist added at owner request; rigorous-research re-enabled
	"disabled_skills": [
		"academic-paper",
		"academic-paper-reviewer",
		"academic-pipeline",
		"annotate-paper",
		"arxiv-research",
		"build-with-exa",
		"company-research",
		"dappier",
		"data-scientist",
		"deep-research",
		"exa-contents",
		"exa-search",
		"firecrawl",
		"firecrawl-agent",
		"firecrawl-alexandria",
		"firecrawl-crawl",
		"firecrawl-developer-index",
		"firecrawl-download",
		"firecrawl-interact",
		"firecrawl-map",
		"firecrawl-monitor",
		"firecrawl-parse",
		"firecrawl-research-index",
		"firecrawl-scrape",
		"firecrawl-search",
		"just-scrape",
		"lead-generation",
		"paper-search",
		"prototype",
		"research",
		"scaffold-exercises",
		"sr-screener",
		"tavily-best-practices",
		"tavily-research",
		"tavily-search",
	],
	"formatOnMutation": {
		"mode": "best-effort",
		"maxFileBytes": 1048576,
		"timeoutMs": 3000,
	},
	"git_master": {
		"commit_footer": true,
		"include_co_authored_by": true,
		"git_env_prefix": "GIT_MASTER=1",
	},
	"telemetry": {
		"enabled": false,
	},
}