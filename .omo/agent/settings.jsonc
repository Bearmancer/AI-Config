{
	"$schema": "https://pi.dev/schemas/settings.schema.json",
	"enabledModels": [
		"anthropic-subscription/claude-sonnet-5-5",
		"anthropic-subscription/claude-haiku-5-5",
		"qwen-token-plan/qwen3.8-flash",
	],
	"hideThinkingBlock": true,
	"defaultProvider": "anthropic-subscription",
	"favoriteModels": [
		"anthropic-subscription/claude-sonnet-5-5",
		"anthropic-subscription/claude-haiku-5-5",
		"qwen-token-plan/qwen3.8-flash",
	],
	"defaultProjectTrust": "always",
	"autocompleteMaxVisible": 10,
	"cacheWarming": "streaming",
	"defaultModel": "anthropic-subscription/claude-sonnet-5-5",
	"defaultThinkingLevel": "high",
	"doubleEscapeAction": "none",
	"enableInstallTelemetry": false,
	"tuiMode": "fullscreen",
	"showHardwareCursor": true,
	"steeringMode": "all",
	"showCacheMissNotices": true,
	// Core skill filter for ~/.agents/skills (omo.jsonc disabled_skills covers bundled skills only).
	"skills": [
		"!**/academic-paper",
		"!**/academic-paper-reviewer",
		"!**/academic-pipeline",
		"!**/annotate-paper",
		"!**/arxiv-research",
		"!**/build-with-exa",
		"!**/company-research",
		"!**/dappier",
		"!**/deep-research",
		"!**/exa-contents",
		"!**/exa-search",
		"!**/firecrawl",
		"!**/firecrawl-agent",
		"!**/firecrawl-alexandria",
		"!**/firecrawl-crawl",
		"!**/firecrawl-developer-index",
		"!**/firecrawl-download",
		"!**/firecrawl-interact",
		"!**/firecrawl-map",
		"!**/firecrawl-monitor",
		"!**/firecrawl-parse",
		"!**/firecrawl-research-index",
		"!**/firecrawl-scrape",
		"!**/firecrawl-search",
		"!**/just-scrape",
		"!**/lead-generation",
		"!**/paper-search",
		"!**/prototype",
		"!**/research",
		"!**/scaffold-exercises",
		"!**/sr-screener",
		"!**/tavily-research",
		"!**/tavily-search",
	],
}
