{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  // Give Magic Context sessions launched from the home directory their own memory.
  "allow_home_project": true,
  // Historian model chain: free Zen -> free Go -> Go Muse -> Gemini Flash High -> Qwen Flash.
  "historian": {
    "opencode": {
      "model": "opencode/beam-free",
      "fallback_models": [
        "opencode-go/beam-free",
        "opencode-go/muse-spark-1.3-contributor",
        "google/antigravity-gemini-3.8-flash-high",
        "alibaba-token-plan/qwen3.8-flash"
      ]
    }
  }
}
