{
  "$schema": "https://opencode.ai/v2/cli.json",
  "session": {
    "permissions": "autoaccept",
    "sidebar": "auto",
    "scrollbar": true,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": true,
    "tps": true,
    "new_location": "launch"
  },
  "keybinds": {
    "session.tab.select.1": "alt+1",
    "session.tab.select.2": "alt+2",
    "session.tab.select.3": "alt+3",
    "session.tab.select.4": "alt+4",
    "session.tab.select.5": "alt+5",
    "session.tab.select.6": "alt+6",
    "session.tab.select.7": "alt+7",
    "session.tab.select.8": "alt+8",
    "session.tab.select.9": "alt+9",
    "session.tab.select.10": "alt+0"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "prompt": {
    "paste": "full",
    "image_preview": false
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
