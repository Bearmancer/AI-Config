{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [
		"~/.agents/AGENTS.md"
	],
	"update": "disable",
	"share": "manual",
	"model": "google/antigravity-gemini-3.8-flash-high",
	"plugins": [
		"opencode-antigravity-auth@2.1.2",
		"oh-my-opencode-slim",
		"@cortexkit/opencode-magic-context@0.49.35",
		"@slkiser/opencode-quota@6.2.1"
	],	"compaction": {
		"auto": false
	},
	"experimental": {
		"todo": true,
		"artifacts": true,
		"background_compaction": true,
	},
	"lsp": true,
	"snapshots": false,
	"warming": true,
	"websearch": {
		"provider": "random"
	},
	"agents": {
		"build": {
			"model": "google/antigravity-gemini-3.8-flash-high"
		},
		"plan": {
			"model": "google/antigravity-gemini-3.8-flash-high"
		},
		"explore": {
			"disabled": true
		},
		"general": {
			"disabled": true
		},
	},
	"permissions": [
		{
			"action": "*",
			"resource": "*",
			"effect": "allow"
		}
	],
	// Vertex denied wholesale (owner, 2026-11-05): one provider.use policy replaces the old per-model google-vertex disable block.
	"policies": [
		{
			"action": "provider.use",
			"resource": "google-vertex",
			"effect": "deny"
		}
	],
	"tool_output": {
		"max_lines": 2000,
		"max_bytes": 51200
	},
	"mcp": {
		"servers": {
			"agentql": {
				"disabled": true,
				"type": "local",
				"command": [
					"agentql-mcp"
				],
				"environment": {
					"AGENTQL_API_KEY": "{env:AGENTQL_API_KEY}"
				}
			},
			"arxiv": {
				"disabled": true,
				"type": "local",
				"command": [
					"arxiv-mcp-server"
				]
			},
			"codegraph": {
				"type": "local",
				"command": [
					"codegraph",
					"serve",
					"--mcp"
				]
			},
			"dappier": {
				"disabled": true,
				"type": "local",
				"command": [
					"dappier-mcp"
				],
				"environment": {
					"DAPPIER_API_KEY": "{env:DAPPIER_API_KEY}"
				}
			},
			"exa": {
				"disabled": true,
				"type": "local",
				"command": [
					"exa-mcp-server"
				],
				"environment": {
					"EXA_API_KEY": "{env:EXA_API_KEY}"
				}
			},
			"firecrawl": {
				"disabled": true,
				"type": "local",
				"command": [
					"firecrawl-mcp"
				],
				"environment": {
					"FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
				}
			},
			"paper-search": {
				"disabled": true,
				"type": "local",
				"command": [
					"paper-search-mcp"
				]
			},
			"scrapegraph": {
				"disabled": true,
				"type": "local",
				"command": [
					"scrapegraph-mcp"
				],
				"environment": {
					"SGAI_API_KEY": "{env:SGAI_API_KEY}"
				}
			},
			"tavily": {
				"disabled": true,
				"type": "local",
				"command": [
					"tavily-mcp"
				],
				"environment": {
					"TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
				}
			},
			"zotero": {
				"disabled": true,
				"type": "local",
				"command": [
					"zotero-mcp"
				],
				"environment": {
					"ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
					"ZOTERO_LIBRARY_ID": "22374787"
				}
			}
		}
  },
  "providers": {
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {},
    // Claude 5.5 family only (owner rule, no Opus). OpenCode v2 hides models via models.<id>.disabled (v1 whitelist/blacklist keys are dropped by v2).
    // claude-agent keeps only the sonnet/haiku aliases: Claude Code docs resolve them to Sonnet 5.5 / Haiku 5.5 on the Anthropic API.
    "anthropic": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-fable-5-1": { "disabled": true },
        "claude-haiku-4-5": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-opus-4-5": { "disabled": true },
        "claude-opus-4-5-20251101": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-4-8-fast": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-opus-5-5": { "disabled": true },
        "claude-opus-5-5-fast": { "disabled": true },
        "claude-opus-5-fast": { "disabled": true },
        "claude-sonnet-4-5": { "disabled": true },
        "claude-sonnet-4-5-20250929": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true }
      }
    },
    "claude-agent": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "fable": { "disabled": true },
        "opus": { "disabled": true }
      }
    },
    "google": {
      "models": {}
    }
    },
    "provider": {
      // Detected alibaba-token-plan authentication; opencode-quota added this global provider declaration.
      "alibaba-token-plan": {},
      // Detected google-agy authentication; opencode-quota added this global provider declaration.
      "google-agy": {}
    }
}
