{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "update": "disable",
  "share": "manual",
  "model": "commandcode/deepseek/deepseek-v4.1-flash",
  "default_agent": "orchestrator",
  "shell": "C:\\Program Files\\WindowsApps\\Microsoft.PowerShell_7.6.9.0_x64__8wekyb3d8bbwe\\pwsh.exe",
  "plugins": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context",
    "@slkiser/opencode-quota"
  ],
  "compaction": {
    "auto": false
  },
  "experimental": {
    "todo": true,
    "artifacts": true,
    "background_compaction": true,
  },
  "lsp": true,
  "snapshots": false,
  "warming": true,
  "websearch": {
    "provider": "random"
  },
  "agents": {
    "build": {
      "model": "opencode-go/beam-free"
    },
    "plan": {
      "model": "opencode-go/beam-free"
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  // Vertex denied wholesale (owner, 2026-11-05): one provider.use policy replaces the old per-model google-vertex disable block.
  "policies": [
    {
      "action": "provider.use",
      "resource": "google-vertex",
      "effect": "deny"
    }
  ],
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "mcp": {
    "servers": {
      "agentql": {
        "disabled": true,
        "type": "local",
        "command": [
          "agentql-mcp"
        ],
        "environment": {
          "AGENTQL_API_KEY": "{env:AGENTQL_API_KEY}"
        }
      },
      "arxiv": {
        "disabled": true,
        "type": "local",
        "command": [
          "arxiv-mcp-server"
        ]
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
      },
      "dappier": {
        "disabled": true,
        "type": "local",
        "command": [
          "dappier-mcp"
        ],
        "environment": {
          "DAPPIER_API_KEY": "{env:DAPPIER_API_KEY}"
        }
      },
      "exa": {
        "disabled": true,
        "type": "local",
        "command": [
          "exa-mcp-server"
        ],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}"
        }
      },
      "firecrawl": {
        "disabled": true,
        "type": "local",
        "command": [
          "firecrawl-mcp"
        ],
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      },
      "paper-search": {
        "disabled": true,
        "type": "local",
        "command": [
          "paper-search-mcp"
        ]
      },
      "scrapegraph": {
        "disabled": true,
        "type": "local",
        "command": [
          "scrapegraph-mcp"
        ],
        "environment": {
          "SGAI_API_KEY": "{env:SGAI_API_KEY}"
        }
      },
      "tavily": {
        "disabled": true,
        "type": "local",
        "command": [
          "tavily-mcp"
        ],
        "environment": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
        }
      },
      "zotero": {
        "disabled": true,
        "type": "local",
        "command": [
          "zotero-mcp"
        ],
        "environment": {
          "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
          "ZOTERO_LIBRARY_ID": "22374787"
        }
      }
    }
  },
  "providers": {
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    // Owner rule 2026-11-07: all paid OpenCode Go models are disabled except deepseek-v4.1-flash and muse-spark-1.3-contributor (owner amendment 2026-11-09; 2 of 30 live paid ids enabled). The
    // provider stays declared so its three free models (beam-free, crouton-alpha-free,
    // iceman-contributor-free) remain reachable.
    "opencode-go": {
      "models": {
        "claude-haiku-5-5": { "disabled": true },
        "deepseek-v4-pro": { "disabled": true },
        "gemini-4-argon": { "disabled": true },
        "glm-5.2": { "disabled": true },
        "glm-5.3": { "disabled": true },
        "glm-5.3-flash": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-6-luna": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "hy3": { "disabled": true },
        "hy4": { "disabled": true },
        "hy4-preview": { "disabled": true },
        "kimi-k2.7-code": { "disabled": true },
        "kimi-k3": { "disabled": true },
        "kimi-k3.1-pro": { "disabled": true },
        "longcat-2.0": { "disabled": true },
        "mimo-v2.5": { "disabled": true },
        "mimo-v2.5-pro": { "disabled": true },
        "mimo-v2.6-flash": { "disabled": true },
        "mimo-v2.6-pro": { "disabled": true },
        "minimax-m3": { "disabled": true },
        "minimax-m3.1-flash": { "disabled": true },
        "muse-spark-1.2-contributor": { "disabled": true },
        "qwen3.7-plus": { "disabled": true },
        "qwen3.8-flash": { "disabled": true },
        "qwen3.8-max": { "disabled": true },
        "step-5-preview": { "disabled": true }
      }
    },
    // CommandCode whitelist (owner 2026-11-09): only deepseek/deepseek-v4.1-flash and
    // meta/muse-spark-1.3-contributor stay enabled (+ any free ids; none exist in this catalog).
    // models-only overlay preserves the auth-store connection, same shape as opencode-go above.
    "commandcode": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-fable-5-1": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-haiku-5-5": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-opus-5-5": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "claude-sonnet-5-5": { "disabled": true },
        "deepseek/deepseek-v4-flash": { "disabled": true },
        "deepseek/deepseek-v4-flash-fast": { "disabled": true },
        "deepseek/deepseek-v4-flash-vision-exp": { "disabled": true },
        "deepseek/deepseek-v4-pro": { "disabled": true },
        "deepseek/deepseek-v4.1-flash-fast": { "disabled": true },
        "google/gemini-3.1-flash-lite": { "disabled": true },
        "google/gemini-3.5-flash": { "disabled": true },
        "google/gemini-3.5-flash-lite": { "disabled": true },
        "google/gemini-3.6-flash": { "disabled": true },
        "google/gemini-3.7-flash": { "disabled": true },
        "google/gemini-3.8-flash": { "disabled": true },
        "google/gemini-4-argon": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "gpt-5.4": { "disabled": true },
        "gpt-5.4-mini": { "disabled": true },
        "gpt-5.5": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-5.6-sol": { "disabled": true },
        "gpt-5.6-terra": { "disabled": true },
        "gpt-6-astra": { "disabled": true },
        "gpt-6-luna": { "disabled": true },
        "gpt-6-sol": { "disabled": true },
        "gpt-6.1-sol": { "disabled": true },
        "gpt-6.1-terra": { "disabled": true },
        "meta/muse-spark-1.1": { "disabled": true },
        "meta/muse-spark-1.2": { "disabled": true },
        "meta/muse-spark-1.2-contributor": { "disabled": true },
        "meta/muse-spark-1.3": { "disabled": true },
        "meta/muse-wonder-1.0": { "disabled": true },
        "MiniMaxAI/MiniMax-M2.5": { "disabled": true },
        "MiniMaxAI/MiniMax-M2.7": { "disabled": true },
        "MiniMaxAI/MiniMax-M3": { "disabled": true },
        "mistral/mistral-large-4": { "disabled": true },
        "moonshotai/Kimi-K2.7-Code": { "disabled": true },
        "moonshotai/Kimi-K2.7-Code-Highspeed": { "disabled": true },
        "moonshotai/Kimi-K3": { "disabled": true },
        "nvidia/nemotron-3-ultra-550b-a55b": { "disabled": true },
        "Qwen/Qwen3.8-27B": { "disabled": true },
        "Qwen/Qwen3.8-Flash": { "disabled": true },
        "Qwen/Qwen3.8-Max": { "disabled": true },
        "Qwen/Qwen3.8-Max-0902": { "disabled": true },
        "Qwen/Qwen3.8-Omni-Flash": { "disabled": true },
        "sakana/fugu-ultra": { "disabled": true },
        "stepfun/Step-3.5-Flash": { "disabled": true },
        "stepfun/Step-3.7-Flash": { "disabled": true },
        "stepfun/Step-5-Preview": { "disabled": true },
        "tencent/hy3-paid": { "disabled": true },
        "tencent/hy4-preview": { "disabled": true },
        "thinkingmachines/inkling": { "disabled": true },
        "thinkingmachines/inkling-small": { "disabled": true },
        "xai/grok-4.5": { "disabled": true },
        "xai/grok-4.6": { "disabled": true },
        "xai/grok-4.7": { "disabled": true },
        "z-ai/glm-5.3-flash": { "disabled": true },
        "z-ai/glm-5.3-flashx": { "disabled": true },
        "zai-org/GLM-5.2": { "disabled": true },
        "zai-org/GLM-5.2-Fast": { "disabled": true },
        "zai-org/GLM-5.3": { "disabled": true }
      }
    },
    // Claude 5.5 family only (owner rule, no Opus). OpenCode v2 hides models via models.<id>.disabled (v1 whitelist/blacklist keys are dropped by v2).
    // claude-agent keeps only the sonnet/haiku aliases: Claude Code docs resolve them to Sonnet 5.5 / Haiku 5.5 on the Anthropic API.
    "anthropic": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-fable-5-1": { "disabled": true },
        "claude-haiku-4-5": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-opus-4-5": { "disabled": true },
        "claude-opus-4-5-20251101": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-4-8-fast": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-opus-5-5-fast": { "disabled": true },
        "claude-opus-5-fast": { "disabled": true },
        "claude-sonnet-4-5": { "disabled": true },
        "claude-sonnet-4-5-20250929": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true }
      }
    },
    "claude-agent": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "fable": { "disabled": true },
        "opus": { "disabled": true }
      }
    }
  }
}
