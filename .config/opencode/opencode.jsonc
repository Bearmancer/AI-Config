{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [
		"~/.agents/AGENTS.md"
	],
	"mcp": {
		"servers": {
			"codegraph": {
				"type": "local",
				"command": [
					"codegraph",
					"serve",
					"--mcp"
				],
				"disabled": false,
				"codemode": false
			},
			"browse": {
				"type": "local",
				"command": [
					"browse",
					"mcp"
				],
				"cwd": "C:\\Users\\Lance",
				"pool": true,
				"environment": {
					"OPENCODE_BROWSER_RUNTIME": "auto-update",
					"OPENCODE_BROWSER_ALLOW_FILE_URLS": "1"
				}
			},
			"firecrawl": {
				"type": "remote",
				"url": "https://mcp.firecrawl.dev/v2/mcp",
				"oauth": false,
				"headers": {
					"Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
				},
				"disabled": false
			},
			"exa": {
				"type": "remote",
				"url": "https://mcp.exa.ai/mcp",
				"oauth": false,
				"headers": {
					"x-api-key": "{env:EXA_API_KEY}"
				},
				"disabled": false
			},
			"tavily": {
				"type": "remote",
				"url": "https://mcp.tavily.com/mcp/",
				"oauth": false,
				"headers": {
					"Authorization": "Bearer {env:TAVILY_API_KEY}"
				},
				"disabled": false
			},
			"zenrows": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"@zenrows/mcp"
				],
				"environment": {
					"ZENROWS_API_KEY": "{env:ZENROWS_API_KEY}"
				},
				"disabled": false
			},
			"agentql": {
				"type": "local",
				"command": ["agentql-mcp"],
				"environment": {
					"AGENTQL_API_KEY": "{env:AGENTQL_API_KEY}"
				},
				"disabled": true
			},
			"arxiv": {
				"type": "local",
				"command": ["arxiv-mcp-server"],
				"disabled": true
			},
			"dappier": {
				"type": "local",
				"command": ["dappier-mcp"],
				"environment": {
					"DAPPIER_API_KEY": "{env:DAPPIER_API_KEY}"
				},
				"disabled": true
			},
			"paper-search": {
				"type": "local",
				"command": ["paper-search-mcp"],
				"disabled": true
			},
			"scrapegraph": {
				"type": "local",
				"command": ["scrapegraph-mcp"],
				"environment": {
					"SGAI_API_KEY": "{env:SGAI_API_KEY}"
				},
				"disabled": true
			},
			"zotero": {
				"type": "local",
				"command": ["zotero-mcp"],
				"environment": {
					"ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
					"ZOTERO_LIBRARY_ID": "22374787"
				},
				"disabled": true
			}
		}
	},
	"permissions": [
		{
			"action": "skill",
			"resource": "firecrawl*",
			"effect": "deny"
		}
	],
	"plugins": [
		"@cortexkit/opencode-magic-context",
		"oh-my-opencode-slim",
		"@slkiser/opencode-quota"
	],
	"compaction": {
		"auto": false,
	},
	"providers": {
		"alibaba-token-plan": {
			"models": {
				"kimi-k2.5": {
					"disabled": true
				},
				"kimi-k2.6": {
					"disabled": true
				},
				"kimi-k2.7-code": {
					"disabled": true
				},
				"deepseek-v4-flash-0731": {
					"disabled": true
				},
				"deepseek-v4-pro": {
					"disabled": true
				},
				"deepseek-v4-pro-0813": {
					"disabled": true
				},
				"glm-5": {
					"disabled": true
				},
				"glm-5.1": {
					"disabled": true
				},
				"glm-5.2": {
					"disabled": true
				},
				"qwen3.6-flash": {
					"disabled": true
				},
				"qwen3.6-plus": {
					"disabled": true
				},
				"qwen3.7-max": {
					"disabled": true
				},
				"qwen3.7-plus": {
					"disabled": true
				},
				"deepseek-v4.1-flash-1017": {
					"disabled": true
				},
				"glm-5.3": {
					"disabled": true
				},
				"MiniMax-M2.5": {
					"disabled": true
				},
				"qwen3.8-max": {
					"disabled": true
				}
			}
		},
		"claude-agent": {
			"models": {
				"opus": {
					"disabled": false
				},
				"claude-fable-5": {
					"disabled": true
				},
				"claude-fable-5-1": {
					"disabled": true
				},
				"claude-fable-5-2": {
					"disabled": true
				},
				"claude-fable-5-2[1m]": {
					"disabled": true
				},
				"claude-haiku-4-5-20251001": {
					"disabled": true
				},
				"claude-opus-4-6": {
					"disabled": true
				},
				"claude-opus-4-7": {
					"disabled": true
				},
				"claude-opus-4-8": {
					"disabled": true
				},
				"claude-opus-5": {
					"disabled": true
				},
				"claude-sonnet-4-6": {
					"disabled": true
				},
				"claude-sonnet-5": {
					"disabled": true
				},
				"fable": {
					"disabled": true
				}
			}
		}
	},
	"policies": [
		{ "action": "provider.use", "resource": "*", "effect": "deny" },
		{ "action": "provider.use", "resource": "alibaba-token-plan", "effect": "allow" },
		{ "action": "provider.use", "resource": "claude-agent", "effect": "allow" }
	]
}
