{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"compactSidebar": true,
	"autoUpdate": true,
	"image_routing": "direct",
	"deepworkGuardMode": "enforce",
	"preset": "free",
	"presets": {
		"free": {
			"orchestrator": {
				"model": [
					"opencode/glm-5.3-flash-free",
					"opencode-go/beam-free"
				],
				"skills": [
					"*"
				]
			},
			"oracle": {
				"model": [
					"opencode/glm-5.3-flash-free",
					"opencode-go/beam-free"
				],
				"skills": [
					"simplify"
				]
			},
			"designer": {
				"model": [
					"opencode/deepseek-v4.1-flash-free",
					"opencode-go/beam-free"
				],
				"skills": []
			},
			"explorer": {
				"model": [
					"opencode/mimo-v2.6-flash-free",
					"opencode-go/beam-free"
				],
				"skills": []
			},
			"fixer": {
				"model": [
					"opencode/mimo-v2.6-flash-free",
					"opencode-go/beam-free"
				],
				"skills": []
			},
			"observer": {
				"model": [
					"opencode/mimo-v2.6-flash-free",
					"opencode-go/beam-free"
				],
				"skills": []
			},
			"default": {
				"model": [
					"opencode/glm-5.3-flash-free",
					"opencode-go/beam-free"
				],
				"skills": []
			}
		},
		// Anthropic: Anthropic models alone (claude-agent aliases resolve to Claude 5.5). Sonnet for judgment seats with haiku as the family-native fallback; haiku alone for the fast seats.
		"anthropic": {
			"orchestrator": {
				"model": [
					"claude-agent/sonnet",
					"claude-agent/haiku"
				],
				"skills": [
					"*"
				]
			},
			"oracle": {
				"model": [
					"claude-agent/sonnet",
					"claude-agent/haiku"
				],
				"skills": [
					"simplify"
				]
			},
			"designer": {
				"model": [
					"claude-agent/sonnet",
					"claude-agent/haiku"
				],
				"skills": []
			},
			"explorer": {
				"model": [
					"claude-agent/haiku"
				],
				"skills": []
			},
			"fixer": {
				"model": [
					"claude-agent/haiku"
				],
				"skills": []
			},
			"observer": {
				"model": [
					"claude-agent/haiku"
				],
				"skills": []
			}
		},
		// Paid: free-first insurance restored per owner (opencode, then opencode-go free), commandcode rungs after (deepseek for implementation judgment, muse-spark for the fast/research seats), Alibaba qwen3.8-flash as final fallback.
		"paid": {
			"orchestrator": {
				"model": [
					"opencode/glm-5.3-flash-free",
					"opencode-go/beam-free",
					"commandcode/deepseek/deepseek-v4.1-flash",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": [
					"*"
				]
			},
			"oracle": {
				"model": [
					"opencode/glm-5.3-flash-free",
					"opencode-go/beam-free",
					"commandcode/meta/muse-spark-1.3-contributor",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": [
					"simplify"
				]
			},
			"designer": {
				"model": [
					"opencode/deepseek-v4.1-flash-free",
					"opencode-go/beam-free",
					"commandcode/deepseek/deepseek-v4.1-flash",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": []
			},
			"explorer": {
				"model": [
					"opencode/beam-free",
					"opencode-go/beam-free",
					"commandcode/meta/muse-spark-1.3-contributor",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": []
			},
			"fixer": {
				"model": [
					"opencode/beam-free",
					"opencode-go/beam-free",
					"commandcode/deepseek/deepseek-v4.1-flash",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": []
			},
			"observer": {
				"model": [
					"opencode/beam-free",
					"commandcode/meta/muse-spark-1.3-contributor",
					"alibaba-token-plan/qwen3.8-flash"
				],
				"skills": []
			}
		}
	},
	"default": {
		"default_preset": "paid-council",
		"presets": {
			"paid-council": {
				"alpha": {
					"model": ["opencode/glm-5.3-flash-free", "opencode-go/beam-free", "commandcode/deepseek/deepseek-v4.1-flash", "alibaba-token-plan/qwen3.8-flash"],
					"variant": "high",
					"prompt": "You are Councillor Alpha, specialized in Code Quality, Implementation Cleanliness, and Syntax Standards. You evaluate code clarity, maintainability, type correctness, edge cases, and unit test coverage."
				},
				"beta": {
					"model": ["opencode/glm-5.3-flash-free", "opencode-go/beam-free", "commandcode/deepseek/deepseek-v4.1-flash", "alibaba-token-plan/qwen3.8-flash"],
					"variant": "high",
					"prompt": "You are Councillor Beta, specialized in System Architecture, Interface Contracts, Modularity, and State Management. You evaluate architectural seams, coupling, data flow, failure modes, and migration safety."
				},
				"gamma": {
					"model": ["opencode/glm-5.3-flash-free", "opencode-go/beam-free", "commandcode/deepseek/deepseek-v4.1-flash", "alibaba-token-plan/qwen3.8-flash"],
					"variant": "high",
					"prompt": "You are Councillor Gamma, specialized in Security, Hardening, and Threat Modeling. You evaluate auth boundaries, input validation, secret hygiene, dependency risks, and permission enforcement."
				},
				"delta": {
					"model": ["opencode/glm-5.3-flash-free", "opencode-go/beam-free", "commandcode/deepseek/deepseek-v4.1-flash", "alibaba-token-plan/qwen3.8-flash"],
					"variant": "high",
					"prompt": "You are Councillor Delta, specialized in Performance, Efficiency, and Scalability. You evaluate memory usage, I/O bottlenecks, concurrency, latency, resource leaks, and caching strategies."
				},
				"epsilon": {
					"model": ["opencode/glm-5.3-flash-free", "opencode-go/beam-free", "commandcode/deepseek/deepseek-v4.1-flash", "alibaba-token-plan/qwen3.8-flash"],
					"variant": "high",
					"prompt": "You are Councillor Epsilon, specialized in Integration, Data Correctness, and Reliability. You evaluate API contracts, serialization boundaries, error handling, data migrations, idempotency, and cross-service failure paths, and you reconcile engineering proposals into clear action items."
				}
			}
		}
	}
}
