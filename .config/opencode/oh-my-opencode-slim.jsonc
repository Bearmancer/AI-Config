{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"preset": "lineup",
	"presets": {
		"lineup": {
			"orchestrator": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen3.8-flash",
						"variant": "xhigh"
					},
					{
						"id": "claude-agent/sonnet"
					}
				],
				"skills": [
					"*"
				],
				"mcps": [
					"*"
				]
			},
			"oracle": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen4-max",
						"variant": "xhigh"
					},
					{
						"id": "claude-agent/sonnet",
						"variant": "high"
					}
				],
				"skills": [
					"simplify",
					"requesting-code-review"
				],
				"mcps": [
					"*"
				]
			},
			"explorer": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen3.8-flash",
						"variant": "low"
					},
					{
						"id": "claude-agent/haiku",
						"variant": "low"
					}
				],
				"skills": [],
				"mcps": [
					"*"
				]
			},
			"designer": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen3.8-flash",
						"variant": "medium"
					},
					{
						"id": "claude-agent/sonnet",
						"variant": "medium"
					}
				],
				"skills": [],
				"mcps": [
					"*"
				]
			},
			"fixer": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen3.8-flash",
						"variant": "low"
					},
					{
						"id": "claude-agent/haiku",
						"variant": "low"
					}
				],
				"skills": [],
				"mcps": [
					"*"
				]
			},
			"observer": {
				"model": [
					{
						"id": "alibaba-token-plan/qwen3.8-flash",
						"variant": "medium"
					},
					{
						"id": "claude-agent/haiku",
						"variant": "medium"
					}
				],
				"skills": [],
				"mcps": []
			}
		}
	},
	"disabled_agents": [],
	"disabled_mcps": [],
	"disabled_tools": [],
	"disabled_skills": [],
	"disabled_hooks": [],
	"disabled_commands": [],
	"image_routing": "auto",
	"tui": true,
	"sidebar": true,
	"compactSidebar": true,
	"liveConfigRefresh": true,
	"autoUpdate": true,
	"marketplace": {
		"enabled": true
	},
	"fallback": {
		"enabled": true,
		"maxRetries": 3,
		"retryDelayMs": 500
	},
	"interview": {
		"enabled": true,
		"maxQuestions": 10,
		"dashboard": true,
		"autoOpenBrowser": true
	},
	"multiplexer": {
		"type": "auto",
		"layout": "main-vertical",
		"main_pane_size": 60
	},
	"council": {
		"default_preset": "default",
		"presets": {
			"default": {
				"alpha": {
					"model": "alibaba-token-plan/qwen3.8-flash",
					"variant": "medium"
				},
				"beta": {
					"model": "alibaba-token-plan/qwen3.8-flash",
					"variant": "xhigh"
				},
				"gamma": {
					"model": "alibaba-token-plan/qwen3.8-flash",
					"variant": "medium"
				}
			}
		}
	},
	"companion": {
		"enabled": false
	}
}